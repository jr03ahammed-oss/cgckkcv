{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User portfolio settings and profile information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User ID matching auth UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Google user email",
          "maxLength": 256
        },
        "companyName": {
          "type": "string",
          "description": "Company or portfolio display name",
          "maxLength": 100
        },
        "ownerName": {
          "type": "string",
          "description": "Optional owner name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Profile photo URL or base64 storage reference",
          "maxLength": 1000000
        },
        "masterCurrency": {
          "type": "string",
          "description": "Global master reporting currency (e.g. SAR, USD)",
          "maxLength": 10
        },
        "defaultCountry": {
          "type": "string",
          "description": "Default country for new investments",
          "maxLength": 100
        },
        "defaultCurrency": {
          "type": "string",
          "description": "Default currency for new investments",
          "maxLength": 10
        },
        "notificationReminder": {
          "type": "boolean",
          "description": "Whether monthly entry reminder is enabled"
        },
        "reminderDay": {
          "type": "number",
          "description": "Day of the month for reminder (1-31)"
        },
        "reminderTime": {
          "type": "string",
          "description": "Reminder time string (HH:MM)",
          "maxLength": 10
        },
        "themePreference": {
          "type": "string",
          "description": "Theme preference: light, dark, or system",
          "maxLength": 20
        },
        "permanentUrl": {
          "type": "string",
          "description": "Official permanent web app URL",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 40
        }
      },
      "required": ["id", "email", "companyName", "masterCurrency"]
    },
    "Investment": {
      "title": "Investment",
      "description": "An investment project or asset belonging to a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique investment ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User ID of the owner",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Investment name or title",
          "maxLength": 150
        },
        "country": {
          "type": "string",
          "description": "Country where the investment is located",
          "maxLength": 100
        },
        "currency": {
          "type": "string",
          "description": "Original currency of the investment (e.g. SAR, BDT, INR, PKR)",
          "maxLength": 10
        },
        "initialCapital": {
          "type": "number",
          "description": "Initial capital deployed"
        },
        "startDate": {
          "type": "string",
          "description": "Start date in YYYY-MM-DD format",
          "maxLength": 20
        },
        "targetPeriod": {
          "type": "string",
          "description": "Target investment duration (e.g. 12 Months, 2 Years)",
          "maxLength": 50
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or details",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 40
        }
      },
      "required": ["id", "userId", "name", "country", "currency", "initialCapital", "startDate"]
    },
    "MonthlyRecord": {
      "title": "MonthlyRecord",
      "description": "Monthly income, expense, and capital movement record for an investment",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique record ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User ID of the owner",
          "maxLength": 128
        },
        "investmentId": {
          "type": "string",
          "description": "Associated investment ID",
          "maxLength": 128
        },
        "month": {
          "type": "string",
          "description": "Month identifier (e.g. Jan 2026 or 2026-01)",
          "maxLength": 30
        },
        "date": {
          "type": "string",
          "description": "Record date in YYYY-MM-DD format",
          "maxLength": 20
        },
        "income": {
          "type": "number",
          "description": "Monthly Income / Return"
        },
        "expense": {
          "type": "number",
          "description": "Monthly Expense"
        },
        "additionalCapital": {
          "type": "number",
          "description": "Additional capital injected this month"
        },
        "withdrawal": {
          "type": "number",
          "description": "Capital or dividend withdrawn this month"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes for this monthly record",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Optional status badge for the month",
          "maxLength": 50
        },
        "exchangeRate": {
          "type": "number",
          "description": "Exchange rate to master currency captured at entry time"
        },
        "exchangeRateDate": {
          "type": "string",
          "description": "Date exchange rate was captured",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 40
        }
      },
      "required": ["id", "userId", "investmentId", "month", "date", "income", "expense", "additionalCapital", "withdrawal"]
    },
    "FundingRecord": {
      "title": "FundingRecord",
      "description": "Capital injection, partner contribution, or funding ledger transaction",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique funding record ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User ID of the owner",
          "maxLength": 128
        },
        "source": {
          "type": "string",
          "description": "Funding source / investor name",
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "description": "Funding transaction type (e.g. Capital Injection, Partner Contribution, Distribution)",
          "maxLength": 50
        },
        "amount": {
          "type": "number",
          "description": "Funding transaction amount"
        },
        "currency": {
          "type": "string",
          "description": "Funding currency code",
          "maxLength": 10
        },
        "date": {
          "type": "string",
          "description": "Funding date in YYYY-MM-DD format",
          "maxLength": 20
        },
        "allocatedInvestmentId": {
          "type": "string",
          "description": "Optional ID of allocated investment, or unallocated",
          "maxLength": 128
        },
        "allocatedInvestmentName": {
          "type": "string",
          "description": "Optional display name of allocated investment",
          "maxLength": 150
        },
        "status": {
          "type": "string",
          "description": "Funding status: Completed, Committed, Pending",
          "maxLength": 30
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or details",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 40
        }
      },
      "required": ["id", "userId", "source", "type", "amount", "currency", "date", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile and portfolio settings"
    },
    "/users/{userId}/investments/{investmentId}": {
      "schema": "Investment",
      "description": "Stores user investment assets"
    },
    "/users/{userId}/investments/{investmentId}/monthlyRecords/{recordId}": {
      "schema": "MonthlyRecord",
      "description": "Stores monthly financial tracking records for an investment"
    },
    "/users/{userId}/fundingRecords/{recordId}": {
      "schema": "FundingRecord",
      "description": "Stores portfolio funding injections, investor contributions, and distributions"
    },
    "/test/{testId}": {
      "schema": "object",
      "description": "Test connection documents"
    }
  }
}
